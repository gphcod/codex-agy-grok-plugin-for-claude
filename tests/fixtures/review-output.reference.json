{
  "provenance": {
    "note": "Reference copy of the shared review-output schema. tests/schema.test.mjs compares plugins/council/schemas/review-output.schema.json with the `schema` member below and never reads an installed plugin cache.",
    "sources": [
      {
        "plugin": "gemini-plugin-cc 2.1.0",
        "file": "plugins/gemini/schemas/review-output.schema.json",
        "repo": "https://github.com/gphcod/gemini-plugin-cc",
        "tag": "gemini--v2.1.0",
        "commit": "9a1431b5ba7c223ede384d41957d3fda2985f55e",
        "sha256": "7acea366c7ca8deb86c6f3106676fe2a83bbc30840e9e8c0110cccb85bfdf476"
      },
      {
        "plugin": "grok-build-plugin-cc 1.1.5",
        "file": "plugins/grok-build/schemas/review-output.schema.json",
        "repo": "https://github.com/gphcod/grok-build-plugin-cc",
        "tag": "v1.1.5",
        "commit": "9c66028422fbf460297de8188e042e7937e0a0e1",
        "sha256": "61dfd412fa3e556acb33bbcec04ba1cb4e7d387c745f092f9bea2cca9d55e530"
      }
    ],
    "comparison": "S1.0, 2026-10-31: the two files are structurally identical (JSON deep-equal); they differ only in whitespace (gemini pretty-printed, grok minified). The gemini copy was taken verbatim."
  },
  "schema": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "type": "object",
    "additionalProperties": false,
    "required": [
      "verdict",
      "summary",
      "findings",
      "next_steps"
    ],
    "properties": {
      "verdict": {
        "type": "string",
        "enum": [
          "approve",
          "needs-attention"
        ]
      },
      "summary": {
        "type": "string",
        "minLength": 1
      },
      "findings": {
        "type": "array",
        "items": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "severity",
            "title",
            "body",
            "file",
            "line_start",
            "line_end",
            "confidence",
            "recommendation"
          ],
          "properties": {
            "severity": {
              "type": "string",
              "enum": [
                "critical",
                "high",
                "medium",
                "low"
              ]
            },
            "title": {
              "type": "string",
              "minLength": 1
            },
            "body": {
              "type": "string",
              "minLength": 1
            },
            "file": {
              "type": "string",
              "minLength": 1
            },
            "line_start": {
              "type": "integer",
              "minimum": 1
            },
            "line_end": {
              "type": "integer",
              "minimum": 1
            },
            "confidence": {
              "type": "number",
              "minimum": 0,
              "maximum": 1
            },
            "recommendation": {
              "type": "string"
            }
          }
        }
      },
      "next_steps": {
        "type": "array",
        "items": {
          "type": "string",
          "minLength": 1
        }
      }
    }
  }
}
